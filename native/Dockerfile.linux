# SPDX-License-Identifier: Apache-2.0
#
# Builds the Linux shared library. No GPU is needed to compile -- nvcc emits
# SASS for the architectures named in CMakeLists without one -- so this runs
# anywhere Docker does, including a Windows host.
#
# Build on Ubuntu 22.04 so the shipped library does not require GCC 13's
# GLIBCXX_3.4.31. CUDA 13 still emits every packaged architecture, while the
# older host toolchain keeps the library loadable in stock RunPod images.

FROM nvidia/cuda:13.0.0-devel-ubuntu22.04

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-pip ninja-build \
    && python3 -m pip install --no-cache-dir cmake==3.28.3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY CMakeLists.txt ./
COPY src ./src
COPY third_party ./third_party

# Ninja rather than Make: the flags land literally, which matters here because
# the exception-handling settings are load-bearing (see the extern "C" note in
# h3_int8_attention_api.cu).
RUN cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --parallel \
    && strip --strip-unneeded build/libh3_int8_attention.so

# The caller copies this out; see build_linux.sh.
RUN test -f build/libh3_int8_attention.so \
    && echo "built:" && ls -la build/libh3_int8_attention.so
